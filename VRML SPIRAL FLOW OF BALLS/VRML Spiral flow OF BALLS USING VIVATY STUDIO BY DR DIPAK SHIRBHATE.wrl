DEF vizx_init TimeSensor {
 cycleInterval 0.100
 loop TRUE
}
ROUTE vizx_init.cycleTime TO Timer1.startTime
ROUTE vizx_init.cycleTime TO Timer2.startTime
ROUTE vizx_init.cycleTime TO Timer3.startTime
ROUTE vizx_init.cycleTime TO Timer4.startTime
ROUTE vizx_init.cycleTime TO Timer5.startTime
ROUTE vizx_init.cycleTime TO Timer6.startTime
ROUTE vizx_init.cycleTime TO Timer7.startTime
ROUTE vizx_init.cycleTime TO vizx_init.stopTime
ROUTE Timer1.fraction_changed TO Timer1_pos0.set_fraction
ROUTE Timer1_pos0.value_changed TO Particle1.set_translation
ROUTE Timer1.fraction_changed TO Timer1_pos1.set_fraction
ROUTE Timer1_pos1.value_changed TO Particle2.set_translation
ROUTE Timer2.fraction_changed TO Timer2_pos0.set_fraction
ROUTE Timer2_pos0.value_changed TO Particle2.set_translation
ROUTE Timer3.fraction_changed TO Timer3_pos0.set_fraction
ROUTE Timer3_pos0.value_changed TO Particle3.set_translation
ROUTE Timer4.fraction_changed TO Timer4_pos0.set_fraction
ROUTE Timer4_pos0.value_changed TO Particle5.set_translation
ROUTE Timer5.fraction_changed TO Timer5_pos0.set_fraction
ROUTE Timer5_pos0.value_changed TO Particle7.set_translation
ROUTE Timer6.fraction_changed TO Timer6_pos0.set_fraction
ROUTE Timer6_pos0.value_changed TO Particle9.set_translation
ROUTE Timer7.fraction_changed TO Timer7_pos0.set_fraction
ROUTE Timer7_pos0.value_changed TO Particle11.set_translation
ROUTE Timer4.fraction_changed TO Color4.set_fraction
ROUTE Timer6.fraction_changed TO Color6.set_fraction
ROUTE Color6.value_changed TO Material1.set_diffuseColor
ROUTE Timer1.fraction_changed TO Color1.set_fraction
ROUTE Color1.value_changed TO Material1.set_diffuseColor
ROUTE Timer2.fraction_changed TO Color2.set_fraction
ROUTE Color2.value_changed TO Material1.set_diffuseColor
ROUTE Timer3.fraction_changed TO Color3.set_fraction
ROUTE Color3.value_changed TO Material1.set_diffuseColor
ROUTE Timer5.fraction_changed TO Color5.set_fraction
ROUTE Color5.value_changed TO Material1.set_diffuseColor
ROUTE Timer7.fraction_changed TO Color7.set_fraction
ROUTE Color7.value_changed TO Material1.set_diffuseColor
